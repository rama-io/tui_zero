<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/VerticalList_BG2">

    <LinearLayout style="@style/HorizontalList">

        <TextView
            android:id="@+id/formula_name"
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textColor="@color/accent" />

        <FrameLayout
            android:id="@+id/formula_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4sp">

            <ImageView
                style="@style/Icon24"
                android:contentDescription="@string/altdescr_delete"
                android:src="@drawable/px_times" />
        </FrameLayout>
    </LinearLayout>

    <View style="@style/Separator" />

    <TextView
        style="@style/Text"
        android:text="@string/label_formula_x" />

    <View style="@style/SeparatorListVertical" />

    <EditText
        android:id="@+id/formula_x"
        style="@style/EditText"
        android:hint="@string/hint_formula_x"
        android:inputType="textNoSuggestions" />

    <View style="@style/SeparatorListVertical" />

    <TextView
        style="@style/Text"
        android:text="@string/label_formula_y" />

    <View style="@style/SeparatorListVertical" />

    <EditText
        android:id="@+id/formula_y"
        style="@style/EditText"
        android:hint="@string/hint_formula_y"
        android:inputType="textNoSuggestions" />

</LinearLayout>
