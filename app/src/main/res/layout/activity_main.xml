<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    style="@style/VerticalList"
    android:layout_height="match_parent"
    android:background="@color/base"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page_playlist"
            layout="@layout/page_playlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page_visualizer"
            layout="@layout/page_visualizer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <View style="@style/SeparatorListVertical" />

    <FrameLayout
        android:id="@+id/currently_playing_display"
        android:layout_width="match_parent"
        android:layout_height="30sp"
        android:background="@color/crust">

        <View
            android:id="@+id/progress_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/accent_2" />

        <TextView
            android:id="@+id/currently_playing_text"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="16sp"
            android:paddingRight="16sp"
            android:singleLine="true"
            android:text="@string/placeholder_now_playing"
            android:textColor="@color/accent" />
    </FrameLayout>

    <View style="@style/SeparatorListVertical" />

    <LinearLayout
        style="@style/HorizontalList"
        android:background="@color/crust"
        android:baselineAligned="false"
        android:gravity="center"
        android:padding="8dp">

        <FrameLayout
            android:id="@+id/repeat_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/repeat_icon"
                android:layout_width="28sp"
                android:layout_height="28sp"
                android:layout_gravity="center"
                android:contentDescription="@string/altdescr_repeat"
                android:src="@drawable/px_repeat"
                android:tint="@color/text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/prev_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:layout_width="36sp"
                android:layout_height="36sp"
                android:layout_gravity="center"
                android:contentDescription="@string/altdescr_previous"
                android:src="@drawable/px_prev"
                android:tint="@color/text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/play_pause_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/play_pause_icon"
                android:layout_width="42sp"
                android:layout_height="42sp"
                android:layout_gravity="center"
                android:contentDescription="@string/altdescr_play_pause"
                android:src="@drawable/px_play_circle"
                android:tint="@color/text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/next_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:layout_width="36sp"
                android:layout_height="36sp"
                android:layout_gravity="center"
                android:contentDescription="@string/altdescr_next"
                android:src="@drawable/px_next"
                android:tint="@color/text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/shuffle_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:layout_width="28sp"
                android:layout_height="28sp"
                android:layout_gravity="center"
                android:contentDescription="@string/altdescr_shuffle"
                android:src="@drawable/px_shuffle"
                android:tint="@color/text" />
        </FrameLayout>
    </LinearLayout>

    <View style="@style/SeparatorListVertical" />

    <com.rama.tui_zero.widgets.WdNavbar
        android:id="@+id/navbar"
        style="@style/HorizontalList" />

</LinearLayout>
