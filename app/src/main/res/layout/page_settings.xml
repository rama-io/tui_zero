<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/VerticalList"
    android:layout_height="match_parent">

    <TextView
        style="@style/H2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/header_settings" />

    <View style="@style/SeparatorListVertical" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:cacheColorHint="@android:color/transparent"
        android:fadingEdge="none"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout style="@style/VerticalList">

            <!-- System -->
            <com.rama.tui_zero.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:defaultExpanded="true"
                app:header="@string/header_system"
                app:key="settings:section:system">

                <Button
                    android:id="@+id/media_permission_button"
                    style="@style/BTN"
                    android:text="@string/btn_grant_media" />

                <View style="@style/SeparatorListVertical" />

                <Button
                    android:id="@+id/storage_permission_button"
                    style="@style/BTN"
                    android:text="@string/btn_grant_storage" />

                <View
                    android:id="@+id/storage_separator"
                    style="@style/SeparatorListVertical" />

                <Button
                    android:id="@+id/notification_permission_button"
                    style="@style/BTN"
                    android:text="@string/btn_grant_notifications" />

                <View
                    android:id="@+id/background_separator"
                    style="@style/SeparatorListVertical" />

                <Button
                    android:id="@+id/background_playback_button"
                    style="@style/BTN"
                    android:text="@string/btn_background_playback" />

                <View style="@style/SeparatorListVertical" />

                <com.rama.tui_zero.widgets.WdCheckbox
                    android:id="@+id/show_system_bar"
                    style="@style/Checkbox"
                    android:text="@string/label_show_system_bar" />

                <View style="@style/SeparatorListVertical" />

                <com.rama.tui_zero.widgets.WdCheckbox
                    android:id="@+id/keep_screen_awake"
                    style="@style/Checkbox"
                    android:text="@string/label_keep_screen_awake" />

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_app_zoom" />

                    <View style="@style/SeparatorListVertical" />

                    <LinearLayout style="@style/HorizontalList">

                        <EditText
                            android:id="@+id/zoom"
                            style="@style/EditText"
                            android:layout_weight="1"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="3"
                            android:text="100" />

                        <View style="@style/SeparatorListHorizontal" />

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:text="@string/label_zoom_unit" />
                    </LinearLayout>
                </LinearLayout>
            </com.rama.tui_zero.widgets.WdCollapsibleSection>

            <View style="@style/SeparatorListVertical" />

            <com.rama.tui_zero.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:defaultExpanded="true"
                app:header="@string/header_folders"
                app:key="settings:section:folders">

                <LinearLayout style="@style/VerticalList">

                    <TextView
                        android:id="@+id/folders_empty"
                        style="@style/Text"
                        android:text="@string/label_folders_empty"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/folders_container"
                        style="@style/VerticalListDivided" />
                </LinearLayout>
            </com.rama.tui_zero.widgets.WdCollapsibleSection>

            <View style="@style/SeparatorListVertical" />

            <com.rama.tui_zero.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:defaultExpanded="true"
                app:header="@string/header_theme"
                app:key="settings:section:themes">

                <com.rama.tui_zero.widgets.WdRadioGroup
                    android:id="@+id/theme_group"
                    style="@style/VerticalList_BG2" />
            </com.rama.tui_zero.widgets.WdCollapsibleSection>

            <View
                android:id="@+id/accent_separator"
                style="@style/SeparatorListVertical" />

            <com.rama.tui_zero.widgets.WdCollapsibleSection
                android:id="@+id/accent_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:defaultExpanded="true"
                app:header="@string/header_accent"
                app:key="settings:section:accent">

                <com.rama.tui_zero.widgets.WdRadioGroup
                    android:id="@+id/accent_group"
                    style="@style/VerticalList_BG2" />
            </com.rama.tui_zero.widgets.WdCollapsibleSection>

            <View style="@style/SeparatorListVertical" />

            <com.rama.tui_zero.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:defaultExpanded="true"
                app:header="@string/header_list"
                app:key="settings:section:list">

                <com.rama.tui_zero.widgets.WdRadioGroup
                    android:id="@+id/sort_group"
                    style="@style/VerticalList_BG2" />

                <View style="@style/SeparatorListVertical" />

                <com.rama.tui_zero.widgets.WdCheckbox
                    android:id="@+id/keep_folder_files_together"
                    style="@style/Checkbox"
                    android:text="@string/label_keep_folder_together" />

                <View style="@style/SeparatorListVertical" />

                <com.rama.tui_zero.widgets.WdCheckbox
                    android:id="@+id/respect_nomedia"
                    style="@style/Checkbox"
                    android:text="@string/label_respect_nomedia" />

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_audio_formats" />

                    <View style="@style/SeparatorListVertical" />

                    <LinearLayout
                        android:id="@+id/audio_formats_container"
                        style="@style/VerticalListDivided" />
                </LinearLayout>
            </com.rama.tui_zero.widgets.WdCollapsibleSection>

            <View style="@style/SeparatorListVertical" />

            <com.rama.tui_zero.widgets.WdCollapsibleSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:defaultExpanded="true"
                app:header="@string/header_visualizer"
                app:key="settings:section:visualizer">

                <TextView
                    android:id="@+id/visualizer_status"
                    style="@style/Text_Center"
                    android:background="@color/crust"
                    android:padding="8sp" />

                <View style="@style/SeparatorListVertical" />

                <LinearLayout style="@style/VerticalList_BG2">

                    <TextView
                        style="@style/Text"
                        android:text="@string/label_visualizer_delay" />

                    <View style="@style/SeparatorListVertical" />

                    <EditText
                        android:id="@+id/visualizer_delay"
                        style="@style/EditText"
                        android:inputType="number" />

                </LinearLayout>

                <View style="@style/SeparatorListVertical" />

                <LinearLayout
                    android:id="@+id/counters_container"
                    style="@style/VerticalListDivided" />

                <View style="@style/SeparatorListVertical" />

                <LinearLayout
                    android:id="@+id/formulas_container"
                    style="@style/VerticalListDivided" />

                <View style="@style/SeparatorListVertical" />

                <Button
                    android:id="@+id/add_counter"
                    style="@style/BTN"
                    android:text="@string/btn_add_counter" />

                <View style="@style/SeparatorListVertical" />

                <Button
                    android:id="@+id/add_formula"
                    style="@style/BTN"
                    android:text="@string/btn_add_formula" />
            </com.rama.tui_zero.widgets.WdCollapsibleSection>
        </LinearLayout>
    </ScrollView>

    <View style="@style/Separator" />

    <Button
        android:id="@+id/go_about"
        style="@style/BTN"
        android:text="@string/btn_about" />

</LinearLayout>
